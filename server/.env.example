# ===== 服务器自身 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ===== 数据库密码（docker-compose 使用，建议修改）=====
DB_PASSWORD=your_db_password

# ===== PostgreSQL 连接地址 =====
# Docker 部署：docker-compose 会通过 environment 注入正确的内网地址，此处可忽略
# 本地开发：改为 localhost
# DATABASE_URL=postgresql+asyncpg://huoyejia:your_db_password@localhost:5432/huoyejia

# ============================================================
# ChatGPT 模型（对话/摘要/标签/讲解）
# 以下三选一，取消注释你想用的那组
# ============================================================

# --- 方案A：DeepSeek（推荐，国内低延迟，性价比高）---
LLM_CHAT_BASE_URL=https://api.deepseek.com
LLM_CHAT_API_KEY=sk-your-deepseek-api-key
LLM_CHAT_MODEL=deepseek-v4-flash

# --- 方案B：阿里百炼 通义千问（阿里云同 Region 延迟最低）---
# LLM_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_CHAT_API_KEY=sk-your-dashscope-api-key
# LLM_CHAT_MODEL=qwen-plus

# --- 方案C：OpenAI ---
# LLM_CHAT_BASE_URL=https://api.openai.com/v1
# LLM_CHAT_API_KEY=sk-your-openai-api-key
# LLM_CHAT_MODEL=gpt-4o

# ============================================================
# Embedding 模型（文本转向量）
# ============================================================

# --- 方案A：OpenAI text-embedding（效果稳定）---
LLM_EMBEDDING_BASE_URL=https://api.openai.com/v1
LLM_EMBEDDING_API_KEY=sk-your-openai-api-key
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_PATH=/embeddings

# --- 方案B：阿里百炼 文本向量 ---
# LLM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_EMBEDDING_API_KEY=sk-your-dashscope-api-key
# LLM_EMBEDDING_MODEL=text-embedding-v4
# LLM_EMBEDDING_PATH=/embeddings

# ===== 图片生成（可选，不填则功能不启用）=====
LLM_IMAGE_BASE_URL=
LLM_IMAGE_API_KEY=
LLM_IMAGE_MODEL=

# ===== 视频生成（可选，不填则功能不生效）=====
VIDEO_BASE_URL=
VIDEO_API_KEY=
VIDEO_MODEL=
